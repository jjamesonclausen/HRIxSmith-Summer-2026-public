filters:
  and:
    - file.hasTag("designs")
views:
  - type: table
    name: Table
    groupBy:
      property: Cut-in speed (m/s)
      direction: ASC
    order:
      - file.name
      - Cut-in speed (m/s)
      - max Cp (4-8 m/s)
      - max Cp (1-4 m/s)
      - Rated speed (m/s)
      - max TSR (4-8 m/s)
      - max starting torque (Nm), (0-3 m/s)
      - max TSR (1-4 m/s)
      - Cut-out speed (m/s)
      - Efficiency (%)
      - Swept area (m^2)
    sort:
      - property: max Cp (1-4 m/s)
        direction: ASC
  - type: cards
    name: View
    cardSize: 270
    imageAspectRatio: 1.2
